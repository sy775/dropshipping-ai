# Copier en .env et remplir. Ne jamais committer .env.

# Anthropic (utilisé seulement si LLM_LIVE=1)
ANTHROPIC_API_KEY=

# Alertes Telegram (sans jeton : les alertes sont seulement écrites dans les logs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dry-run par défaut : mettre 1 pour autoriser les appels réels au fournisseur
LLM_LIVE=0

# Optionnel : emplacements (par défaut <dépôt>/config et <dépôt>/data/journal.sqlite)
# DROPSHIP_CONFIG_DIR=
# JOURNAL_DB_PATH=
