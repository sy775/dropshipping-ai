{
  "permissions": {
    "deny": [
      "Edit(tests/test_audit_guards.py)",
      "Edit(tools/hooks/pre_tool_use.py)",
      "Edit(tools/hooks/critic_bash.py)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/agents/critic.md)",
      "Edit(.github/workflows/ci.yml)",
      "Edit(tools/audit.py)",
      "Edit(.env)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git filter-repo *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/pre_tool_use.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/stop_pytest.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
